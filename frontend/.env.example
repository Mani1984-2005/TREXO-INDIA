# TREXO frontend configuration.
# Copy to `.env.local` and adjust for your environment. Never commit real secrets.

# Use the built-in mock services (offline demo) when true.
VITE_USE_MOCK=true

# FastAPI backend base URL (used when VITE_USE_MOCK=false).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
